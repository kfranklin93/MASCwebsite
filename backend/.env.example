# ================================================================
# MOMMY ANGELS SPECIALTY CARE - ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your actual values
# ================================================================

# ================================================================
# SERVER CONFIGURATION
# ================================================================
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# ================================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=masc_db
DB_USER=postgres
DB_PASSWORD=your_database_password
DB_SSL=false

# ================================================================
# JWT AUTHENTICATION
# ================================================================
JWT_SECRET=your_very_strong_secret_key_change_this_in_production
JWT_EXPIRY=24h

# ================================================================
# AWS S3 CONFIGURATION
# ================================================================
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=masc-employee-documents

# ================================================================
# SENDGRID EMAIL CONFIGURATION
# ================================================================
SENDGRID_API_KEY=SG.your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@mommyangelsspecialtycare.com
SENDGRID_FROM_NAME=Mommy Angels Specialty Care

# ================================================================
# WEBSITE CONFIGURATION
# ================================================================
WEBSITE_URL=https://mommyangelsspecialtycare.com
ADMIN_EMAIL=info@mommyangelsspecialtycare.com

# ================================================================
# OPTIONAL: AI DOCUMENT CLASSIFICATION
# ================================================================
# Uncomment and configure if using AI features
# OPENAI_API_KEY=sk-your_openai_api_key
# AWS_TEXTRACT_ENABLED=true

# ================================================================
# OPTIONAL: MONITORING & LOGGING
# ================================================================
# LOG_LEVEL=info
# SENTRY_DSN=your_sentry_dsn
