{
  "name": "masc-backend",
  "version": "1.0.0",
  "description": "Backend API for Mommy Angels Specialty Care - Client Intake & Employee Onboarding",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "NODE_ENV=test mocha --require dotenv/config --exit --recursive 'tests/**/*.test.js'",
    "test:watch": "NODE_ENV=test mocha --require dotenv/config --watch --recursive 'tests/**/*.test.js'",
    "test:coverage": "NODE_ENV=test nyc mocha --require dotenv/config --exit --recursive 'tests/**/*.test.js'"
  },
  "keywords": ["aba", "therapy", "intake", "onboarding"],
  "author": "Mommy Angels Specialty Care",
  "license": "ISC",
  "dependencies": {
    "@sendgrid/mail": "^8.1.4",
    "aws-sdk": "^2.1691.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-validator": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "multer-s3": "^3.0.1",
    "nodemailer": "^6.10.0",
    "pg": "^8.13.1",
    "uuid": "^11.0.3"
  },
  "devDependencies": {
    "chai": "^4.5.0",
    "chai-http": "^4.4.0",
    "mocha": "^10.8.2",
    "nodemon": "^3.1.9",
    "nyc": "^17.1.0",
    "sinon": "^19.0.2",
    "supertest": "^7.0.0"
  }
}
